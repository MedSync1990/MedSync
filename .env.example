# MedSync — Master Environment Configuration Template
# Used for Docker Compose and root environment references.

# ── Backend Configuration ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/medsync_db
JWT_SECRET=replace-this-with-a-random-32-character-secret-key
JWT_EXPIRY_MINUTES=60
COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend Configuration ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
