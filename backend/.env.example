# MedSync Backend — Environment Variable Template
# Copy this file to backend/.env for local development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/medsync_db
# DATABASE_ADMIN_URL=postgresql://admin_user:password@localhost:5432/medsync_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-this-with-a-random-32-character-secret-key
JWT_EXPIRY_MINUTES=60

# ── Security ──────────────────────────────────────────────────────────────────
# Set to False for local HTTP dev; True for production HTTPS.
COOKIE_SECURE=False

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
